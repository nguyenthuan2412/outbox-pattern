{
    "name": "nguyenthuan2412/outbox-pattern",
    "description": "Framework-agnostic Transactional Outbox abstractions for PHP: contracts + relay/retry/worker orchestration, with Swoole coroutine runtime support. You bring the store and publisher.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/nguyenthuan2412/outbox-pattern",
    "authors": [
        {
            "name": "nguyenthuan2412",
            "homepage": "https://github.com/nguyenthuan2412"
        }
    ],
    "support": {
        "issues": "https://github.com/nguyenthuan2412/outbox-pattern/issues",
        "source": "https://github.com/nguyenthuan2412/outbox-pattern"
    },
    "keywords": [
        "outbox",
        "transactional-outbox",
        "event-driven",
        "swoole",
        "openswoole",
        "microservices"
    ],
    "require": {
        "php": ">=8.1",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-swoole": "Run the relay with coroutine concurrency (Outbox\\Swoole\\SwooleWorker)",
        "ext-openswoole": "Alternative to ext-swoole"
    },
    "autoload": {
        "psr-4": {
            "Outbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Outbox\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit"
    }
}
